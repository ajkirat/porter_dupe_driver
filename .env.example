# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Shown to drivers as where to pay for their pass (optional)
NEXT_PUBLIC_OPERATOR_UPI=yourname@okaxis

# Self-hosted OpenStreetMap services for production (optional; public demo servers are used otherwise)
# NEXT_PUBLIC_OSRM_URL=https://osrm.example.com
# NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.example.com
# NEXT_PUBLIC_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
NEXT_PUBLIC_SUPPORT_PHONE=+919999999999
